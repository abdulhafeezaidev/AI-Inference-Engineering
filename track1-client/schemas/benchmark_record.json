{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InferenceBenchmarkRecord",
  "type": "object",
  "required": [
    "run_id",
    "phase",
    "request_index",
    "prompt_id",
    "concurrency",
    "seed",
    "status",
    "http_status",
    "ttft_ms",
    "tpot_ms",
    "total_latency_ms",
    "prompt_tokens",
    "completion_tokens",
    "tokens_per_sec",
    "error_type",
    "error_message",
    "timestamp_utc"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "enum": ["warmup", "measured"] },
    "request_index": { "type": "integer", "minimum": 0 },
    "prompt_id": { "type": "string", "minLength": 1 },
    "concurrency": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "status": { "type": "string", "enum": ["ok", "error"] },
    "http_status": { "type": ["integer", "null"] },
    "ttft_ms": { "type": ["number", "null"], "minimum": 0 },
    "tpot_ms": { "type": ["number", "null"], "minimum": 0 },
    "total_latency_ms": { "type": "number", "minimum": 0 },
    "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "completion_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "tokens_per_sec": { "type": ["number", "null"], "minimum": 0 },
    "error_type": { "type": ["string", "null"] },
    "error_message": { "type": ["string", "null"] },
    "timestamp_utc": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
